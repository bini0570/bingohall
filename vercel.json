{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "admin/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/admin/assets/(.*)",
      "dest": "/admin/dist/assets/$1"
    },
    {
      "src": "/admin/(manifest\\.json|sw\\.js|.*\\.png|.*\\.ico|.*\\.svg|.*\\.jpg)",
      "dest": "/admin/dist/$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/admin/dist/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}